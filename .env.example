# Copy to .env for local development (`cp .env.example .env`). Every value below is the default unless marked REQUIRED.
# The app validates this file at startup and refuses to boot on a bad value.

# ---- General -------------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Shown in the OpenAPI title, push/e-mail copy and logs. The mock-ups say "Cal AI".
APP_NAME=CalorieScan AI
LOG_LEVEL=info
# Base URL clients reach the API on. Used for signed dev-storage links and the OpenAPI "servers" entry.
PUBLIC_BASE_URL=http://localhost:3000
# Comma-separated browser origins allowed by CORS. Mobile apps do not need this. Empty = no cross-origin access.
# The web app (calcam-frontend) runs on port 3001 in development.
CORS_ORIGINS=http://localhost:3001
# Reverse proxies in front of the API (1 behind an AWS ALB). Needed for correct per-IP rate limits.
TRUST_PROXY=0
# Languages offered on the welcome screen's language switch.
SUPPORTED_LOCALES=en,km

# ---- Database and Redis --------------------------------------------------------------------------
# REQUIRED. `docker compose up postgres` or `npm run db:embedded` (no Docker) both give you this database.
DATABASE_URL=postgresql://calcam:calcam@localhost:5432/calcam
# Needed for QUEUE_DRIVER=bullmq (the default) and for Redis-backed rate limits.
REDIS_URL=redis://localhost:6379

# ---- Auth ----------------------------------------------------------------------------------------
# REQUIRED. 32+ characters in production: `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-0123456789
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Verification of Apple / Google identity tokens. Comma-separated audiences (Apple: bundle or Services ID).
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_CLIENT_IDS=
# Password reset by e-mail. Needs MAIL_DRIVER=smtp in production.
FEATURE_PASSWORD_RESET=false
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_URL=calcam://reset-password
MAIL_DRIVER=log
MAIL_FROM=no-reply@example.com
# e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=

# ---- Object storage (meal images are private; reads use 15-minute signed URLs) --------------------
# cloudinary = Cloudinary (private "authenticated" assets). s3 = AWS S3 or MinIO. fs = local folder (development,
# works across API and worker). memory = tests only.
STORAGE_DRIVER=s3
# Cloudinary credentials, from the dashboard (Settings > API keys). Either the single URL
#   CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# or the three separate values (these win when both are set).
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional prefix for every uploaded file, e.g. calcam/prod, to keep environments apart in one Cloudinary account.
CLOUDINARY_FOLDER=
# Optional. The key of Cloudinary's token-based authentication (hex). With it, signed photo links expire after
# SIGNED_URL_TTL_SECONDS. Without it the links are signed but do not expire. Needs token auth enabled on your account.
CLOUDINARY_AUTH_TOKEN_KEY=
S3_BUCKET=calcam-meals
S3_REGION=us-east-1
# MinIO locally. Leave empty on AWS.
S3_ENDPOINT=http://localhost:9000
# Host used when SIGNING URLs, if clients reach storage on a different address than the API does.
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Encryption at rest for new objects: AES256 | aws:kms | none. Use AES256 (or a bucket default) on AWS.
S3_SSE=none
SIGNED_URL_TTL_SECONDS=900
STORAGE_FS_DIR=.local/storage
# Signs the dev-storage links of STORAGE_DRIVER=fs. Defaults to JWT_ACCESS_SECRET.
STORAGE_SIGNING_SECRET=
UPLOAD_MAX_BYTES=10485760
IMAGE_MAX_DIMENSION=1280

# ---- Queue and worker ----------------------------------------------------------------------------
# bullmq = Redis, separate worker process (production). memory = run jobs inside the API (development only).
QUEUE_DRIVER=bullmq
QUEUE_CONCURRENCY=4
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_MS=2000

# ---- AI provider (only the worker calls it) ------------------------------------------------------
# anthropic | openai | gemini | fake. `fake` needs no key and returns the "Turkey Sandwich With Potato Chips" result.
AI_PROVIDER=fake
# Defaults: anthropic = claude-opus-5-5, openai = gpt-4o, gemini = gemini-3.8-flash. A smaller model (e.g. claude-sonnet-5-5) is cheaper per photo.
AI_MODEL=
# Optional reasoning effort for Anthropic models: low | medium | high | xhigh | max. Omit unless you tune it.
AI_EFFORT=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Any server that speaks the OpenAI chat-completions API.
OPENAI_BASE_URL=https://api.openai.com/v1
# Google AI Studio key, REQUIRED when AI_PROVIDER=gemini.
GEMINI_API_KEY=
# Results below this model-reported confidence are rejected as LOW_CONFIDENCE.
AI_MIN_CONFIDENCE=0.3
AI_TIMEOUT_MS=60000
AI_MAX_CALORIES_PER_SERVING=5000

# ---- Push notifications (Firebase Cloud Messaging; iOS goes through FCM to APNs) -----------------
# log = print instead of sending. fcm = send.
PUSH_DRIVER=log
# Service-account JSON as one line, or set GOOGLE_APPLICATION_CREDENTIALS to a file path.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---- Barcode lookup ------------------------------------------------------------------------------
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
PRODUCT_CACHE_TTL_SECONDS=86400

# ---- Rate limits (requests) ----------------------------------------------------------------------
# redis when REDIS_URL is set, otherwise memory (per process).
RATE_LIMIT_STORE=
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_PLAN_PREVIEW_PER_MIN=30
RATE_LIMIT_ANALYZE_PER_HOUR=20
RATE_LIMIT_GENERAL_PER_MIN=300

# ---- Plan engine tunables (see src/config/plan.ts for activity multipliers and macro splits) -----
PLAN_CALORIE_FLOOR_MALE=1500
PLAN_CALORIE_FLOOR_FEMALE=1200
PLAN_ADJUST_LOSE=-0.15
PLAN_ADJUST_GAIN=0.10
PLAN_MIN_BMI_FOR_LOSE=18.5
# Weight change (kg) after which the app offers to recalculate the plan.
RECALC_WEIGHT_DELTA_KG=1

# ---- Observability -------------------------------------------------------------------------------
SENTRY_DSN=
# Expose Prometheus metrics at /metrics. Keep it off the public internet.
METRICS_ENABLED=false
