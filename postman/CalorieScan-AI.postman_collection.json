{
  "info": {
    "name": "CalorieScan AI API",
    "description": "Generated from the route registry (npm run postman). Start with Auth > Register; its test script stores the tokens. POST /meals/analyze: pick an image file in the form-data body, then poll GET /meals/{{mealId}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "mealId",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Create an account (optionally with the whole onboarding payload)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"me@example.com\",\n  \"password\": \"correct horse battery\",\n  \"onboarding\": {\n    \"sex\": \"female\",\n    \"workoutsPerWeek\": \"0-2\",\n    \"referralSource\": \"tiktok\",\n    \"heightCm\": 167.6,\n    \"weightKg\": 54,\n    \"birthDate\": \"2001-01-01\",\n    \"goal\": \"maintain\",\n    \"targetWeightKg\": null,\n    \"triedOtherApps\": true,\n    \"worksWithProfessional\": false,\n    \"diet\": \"balanced\",\n    \"accomplishment\": \"eat_healthier\",\n    \"heightUnitPref\": \"ft_in\",\n    \"weightUnitPref\": \"kg\",\n    \"locale\": \"en\",\n    \"timezone\": \"Asia/Phnom_Penh\",\n    \"commitment\": {\n      \"committedAt\": \"2026-10-06T16:30:08.114Z\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "When `onboarding` is present, the profile, nutrition goal, first weight log and commitment are stored in the same transaction as the account, so signing up after the funnel is a single call."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.tokens) { pm.collectionVariables.set('accessToken', body.tokens.accessToken); pm.collectionVariables.set('refreshToken', body.tokens.refreshToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in with email and password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"me@example.com\",\n  \"password\": \"correct horse battery\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Sign in with email and password"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.tokens) { pm.collectionVariables.set('accessToken', body.tokens.accessToken); pm.collectionVariables.set('refreshToken', body.tokens.refreshToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in with Apple",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/oauth/apple",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "oauth",
                "apple"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"<identity token from Sign in with Apple>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Verifies the identity token server-side, then creates or links the user."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.tokens) { pm.collectionVariables.set('accessToken', body.tokens.accessToken); pm.collectionVariables.set('refreshToken', body.tokens.refreshToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in with Google",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/oauth/google",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "oauth",
                "google"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"<ID token from Google Sign-In>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Verifies the identity token server-side, then creates or links the user."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.tokens) { pm.collectionVariables.set('accessToken', body.tokens.accessToken); pm.collectionVariables.set('refreshToken', body.tokens.refreshToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Rotate the refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Returns a new access token and a new refresh token. The old refresh token stops working. Presenting an already-rotated token revokes the whole token family (REFRESH_TOKEN_REUSED)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.tokens) { pm.collectionVariables.set('accessToken', body.tokens.accessToken); pm.collectionVariables.set('refreshToken', body.tokens.refreshToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Revoke the refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Idempotent. Also unregister the FCM token with DELETE /me/devices/{token}."
          }
        },
        {
          "name": "Email a password reset link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/password/forgot",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "password",
                "forgot"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"me@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Behind FEATURE_PASSWORD_RESET. Always answers 202, whether or not the email has an account."
          }
        },
        {
          "name": "Choose a new password with a reset token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/password/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "password",
                "reset"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<token from the email>\",\n  \"password\": \"a brand new password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Behind FEATURE_PASSWORD_RESET. Signs the user out of every device."
          }
        }
      ]
    },
    {
      "name": "Onboarding",
      "item": [
        {
          "name": "Selectable values for every onboarding screen",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/onboarding/options",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "onboarding",
                "options"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Codes with English display labels for sex, workouts per week, referral sources, diets, goals and accomplishments, plus supported locales and the edit limits for the plan screen. The client localises labels by code."
          }
        },
        {
          "name": "Calculate a nutrition plan without saving anything",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/onboarding/plan-preview",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "onboarding",
                "plan-preview"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sex\": \"female\",\n  \"birthDate\": \"2001-01-01\",\n  \"heightCm\": 167.6,\n  \"weightKg\": 54,\n  \"workoutsPerWeek\": \"0-2\",\n  \"goal\": \"maintain\",\n  \"diet\": \"balanced\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Stateless. Powers the \"great potential\" chart, the \"setting everything up\" screen and the daily recommendation screen. Returns 422 GOAL_NOT_SUPPORTED when a \"lose\" goal is not advisable (BMI below 18.5), and 422 UNDER_MINIMUM_AGE below 13."
          }
        },
        {
          "name": "Save the onboarding answers for the signed-in user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/onboarding/complete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "onboarding",
                "complete"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sex\": \"female\",\n  \"workoutsPerWeek\": \"0-2\",\n  \"referralSource\": \"tiktok\",\n  \"heightCm\": 167.6,\n  \"weightKg\": 54,\n  \"birthDate\": \"2001-01-01\",\n  \"goal\": \"maintain\",\n  \"targetWeightKg\": null,\n  \"triedOtherApps\": true,\n  \"worksWithProfessional\": false,\n  \"diet\": \"balanced\",\n  \"accomplishment\": \"eat_healthier\",\n  \"heightUnitPref\": \"ft_in\",\n  \"weightUnitPref\": \"kg\",\n  \"locale\": \"en\",\n  \"timezone\": \"Asia/Phnom_Penh\",\n  \"commitment\": {\n    \"committedAt\": \"2026-10-06T16:30:08.114Z\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Same effect as the onboarding payload inside /auth/register, for users who signed up first. Idempotent: if the profile already exists, the stored state is returned unchanged."
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "The signed-in user with profile and active goal",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "The signed-in user with profile and active goal"
          }
        },
        {
          "name": "Edit profile fields",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me",
                "profile"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workoutsPerWeek\": \"3-5\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Changing sex, birthDate, height, weight, goal, activity (workoutsPerWeek) or diet returns a `recalculation` offer. Nothing is recalculated until the client calls POST /me/goals/recalculate. A `weightKg` value is logged as a new weight entry."
          }
        },
        {
          "name": "Language, timezone, units and notifications",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me/preferences",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me",
                "preferences"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"timezone\": \"Asia/Phnom_Penh\",\n  \"weightUnitPref\": \"kg\",\n  \"notificationsEnabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Units only affect display; everything stays metric on the wire."
          }
        },
        {
          "name": "Delete the account",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "The account is disabled immediately and all tokens are revoked. A background job then hard-deletes every row and stored image."
          }
        }
      ]
    },
    {
      "name": "Goals",
      "item": [
        {
          "name": "The active nutrition goal",
          "request": {
            "method": "GET",
            "header": [],
