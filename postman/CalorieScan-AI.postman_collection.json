    {
      "name": "Meals",
      "item": [
        {
          "name": "Upload a food photo for AI analysis",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "X-Timezone",
                "value": "Asia/Phnom_Penh",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/meals/analyze",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "meals",
                "analyze"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "source",
                  "value": "camera",
                  "type": "text"
                },
                {
                  "key": "hint",
                  "value": "",
                  "type": "text",
                  "disabled": true
                }
              ]
            },
            "description": "Used for both camera and gallery photos (`source`). The file type is checked by magic bytes (JPEG, PNG, WebP, HEIC; max 10 MB). The image is resized to 1280 px, stripped of EXIF and stored privately. The meal is created immediately with `status=queued`; poll GET /meals/{id} while it is `queued` or `analyzing`. A push notification is sent on completion. Send an `Idempotency-Key` header to make retries safe."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const m = pm.response.json().meal; if (m) pm.collectionVariables.set('mealId', m.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Log a packaged product by barcode",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Timezone",
                "value": "Asia/Phnom_Penh",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/meals/barcode",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "meals",
                "barcode"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"barcode\": \"3017620422003\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Looks the barcode up in Open Food Facts (cached) and creates a completed meal from the per-serving data. Answers 404 PRODUCT_NOT_FOUND so the client can fall back to manual entry."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const m = pm.response.json().meal; if (m) pm.collectionVariables.set('mealId', m.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Manual entry, or a text description for an AI estimate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Timezone",
                "value": "Asia/Phnom_Penh",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/meals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "meals"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Greek yogurt\",\n  \"calories\": 150,\n  \"proteinG\": 15,\n  \"carbsG\": 8,\n  \"fatG\": 5.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "With `name`, `calories`, `proteinG`, `carbsG` and `fatG` the meal is created as completed (201). With only `description` an AI estimate is queued (202), exactly like a photo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const m = pm.response.json().meal; if (m) pm.collectionVariables.set('mealId', m.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List meals, newest first",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Timezone",
                "value": "Asia/Phnom_Penh",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/meals?date=today&limit=30",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "meals"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "today"
                },
                {
                  "key": "limit",
                  "value": "30"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "With `date` (YYYY-MM-DD, `today` or `yesterday`) returns that calendar day in the user's timezone, or in the `X-Timezone` header when sent. Paginate with `cursor`."
          }
        },
        {
          "name": "Meal detail for the Nutrition screen",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Timezone",
                "value": "Asia/Phnom_Penh",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/meals/{{mealId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "meals",
                "{{mealId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Includes signed image URLs (15 minute expiry), per-serving values, totals, health score and analysis progress."
          }
        },
        {
          "name": "Edit a meal",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Timezone",
                "value": "Asia/Phnom_Penh",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/meals/{{mealId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "meals",
                "{{mealId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Calories and macros are per serving; `quantity` (0.25 to 20) scales them and totals are computed on read. A meal that failed analysis becomes completed when all four nutrition values are supplied."
          }
        },
        {
          "name": "Fix Results: re-analyze with a correction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Timezone",
                "value": "Asia/Phnom_Penh",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/meals/{{mealId}}/fix",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "meals",
                "{{mealId}}",
                "fix"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"instruction\": \"that was chicken, not turkey, and no chips\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Saves the instruction (for example \"that was chicken, not turkey, and no chips\") and re-queues analysis with the original image plus every correction so far. The previous values stay in place until the new result completes."
          }
        },
        {
          "name": "Delete a meal",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Timezone",
                "value": "Asia/Phnom_Penh",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/meals/{{mealId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "meals",
                "{{mealId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Soft delete. Deleted meals disappear from lists and daily totals."
          }
        }
      ]
    },
