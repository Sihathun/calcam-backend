    {
      "name": "Devices",
      "item": [
        {
          "name": "Register an FCM token for push notifications",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me/devices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me",
                "devices"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"fcm-token-from-the-device-0123456789\",\n  \"platform\": \"ios\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Idempotent. A token that was registered by another user (shared device) moves to the caller."
          }
        },
        {
          "name": "Unregister an FCM token (call on logout)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
