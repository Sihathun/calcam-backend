                "goals"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "The active nutrition goal"
          }
        },
        {
          "name": "Edit calories or macros (the pencil icons)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me/goals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me",
                "goals"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"calories\": 2000,\n  \"proteinG\": 130\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Fields you omit keep their current value. Calories are clamped to 800-6000 and macros to their configured limits. Creates a new `user_edited` version; earlier days keep the goal that was active then."
          }
        },
        {
          "name": "Recalculate the plan from the current profile and latest weight",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me/goals/recalculate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me",
                "goals",
                "recalculate"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Recalculate the plan from the current profile and latest weight"
          }
        }
      ]
    },
